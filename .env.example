# Copiez ce fichier en « .env » (cp .env.example .env) et adaptez les valeurs. Ne commitez jamais .env.

# Mot de passe administrateur : utilisé UNIQUEMENT à la première création de la base. Évitez les apostrophes.
ADMIN_PASSWORD=ChangezMoiParUnMotDePasseLongEtUnique

# --- Production avec HTTPS : choisissez UNE des deux options ---
# Votre nom de domaine (l'enregistrement DNS « A » doit déjà pointer vers l'IP du serveur).
DOMAIN=mondomaine.com

# Option A : Caddy (ports 80 et 443 libres sur le serveur). HTTPS et certificat automatiques.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Option B : un Nginx déjà installé sur le serveur (ports 80/443 occupés). Voir nginx/dig-ecom.conf.example.
# Décommentez cette ligne et commentez l'option A :
# COMPOSE_FILE=docker-compose.yml:docker-compose.nginx.yml
